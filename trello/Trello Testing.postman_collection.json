    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData=pm.response.json();\r",
              "\r",
              "pm.environment.set(\"board_id\", jsonData.id);\r",
              "\r",
              "pm.test(\"Check if id exists\", function () {\r",
              "    \r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Check if name exists\", function () {\r",
              "    \r",
              "    pm.expect(jsonData.name).to.exist;\r",
              "});\r",
              "\r",
              "let createdName = pm.environment.get(\"boardName\")\r",
              "pm.test(\"Board name is correct\", function () {\r",
              "    pm.expect(jsonData.name).to.equal(createdName);\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomNum = Math.floor(Math.random() * 900) + 100;\r",
              "pm.environment.set(\"boardName\", \"myboard\" + randomNum);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
