    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData=pm.response.json();\r",
              "\r",
              "pm.environment.set(\"board_id\", jsonData.id);\r",
              "\r",
              "pm.test(\"Check if id exists\", function () {\r",
              "    \r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Check if name exists\", function () {\r",
              "    \r",
              "    pm.expect(jsonData.name).to.exist;\r",
              "});\r",
              "\r",
              "let createdName = pm.environment.get(\"boardName\")\r",
              "pm.test(\"Board name is correct\", function () {\r",
              "    pm.expect(jsonData.name).to.equal(createdName);\r",
              "});\r",
              "\r",
              "pm.test(\"Board id has valid format\", function () {\r",
              "    pm.expect(jsonData.id).to.match(/^[a-f0-9]{24}$/);\r",
              "});\r",
              "\r",
              "pm.test(\"New board is open\", function () {\r",
              "    pm.expect(jsonData.closed).to.equal(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomNum = Math.floor(Math.random() * 900) + 100;\r",
              "pm.environment.set(\"boardName\", \"myboard\" + randomNum);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
